{
  "version": 2,
  "description": "Ilha: noise fBm puxado para baixo nas bordas por um gradiente redondo, pintado por faixas de altura. Os params mudam a escala do relevo, o tamanho da ilha e o nível do mar.",
  "seed": 512,
  "size": {
    "width": 64,
    "height": 40
  },
  "layers": [
    "terreno",
    {
      "name": "altura",
      "kind": "scalar"
    },
    {
      "name": "distancia",
      "kind": "scalar"
    }
  ],
  "tiles": [
    "mar",
    "areia",
    "grama",
    "mata",
    "pedra",
    "neve"
  ],
  "params": {
    "escala": {
      "type": "number",
      "default": 48,
      "min": 8,
      "max": 200,
      "step": 1,
      "description": "Tamanho das formas do relevo, em células: maior, morros mais largos e costa mais lisa"
    },
    "tamanho": {
      "type": "number",
      "default": 0.6,
      "min": 0.2,
      "max": 1.2,
      "step": 0.01,
      "description": "Raio da ilha, em fração do lado menor do mapa: 0,5 encosta nas bordas mais próximas"
    },
    "nivel_do_mar": {
      "type": "number",
      "default": 0.42,
      "min": 0.3,
      "max": 0.5,
      "step": 0.01,
      "description": "Altura abaixo da qual é mar: mais alto, ilha menor; a praia é a faixa logo acima"
    }
  },
  "steps": [
    {
      "id": "relevo",
      "operator": "Noise",
      "config": {
        "layer": "altura",
        "wavelength": {
          "$param": "escala"
        },
        "octaves": 5
      },
      "description": "Ruído fBm (OpenSimplex2, 5 oitavas) de 0 a 1: a altura antes da costa."
    },
    {
      "id": "centro",
      "operator": "RadialGradient",
      "description": "Distância do centro: 0 no meio, 1 numa borda redonda de raio `tamanho`.",
      "config": {
        "layer": "distancia",
        "radius_x": {
          "$param": "tamanho"
        },
        "radius_y": {
          "$param": "tamanho"
        }
      }
    },
    {
      "id": "encosta",
      "operator": "Curve",
      "description": "Eleva a distância ao quadrado e inverte: 1 no centro, caindo devagar perto do meio e depressa perto da borda.",
      "config": {
        "from": "distancia",
        "layer": "distancia",
        "curve": {
          "kind": "power",
          "exponent": 2
        },
        "invert": true
      }
    },
    {
      "id": "costa",
      "operator": "Combine",
      "description": "Mistura a altura com o gradiente (os pesos somam 1): alta no centro, baixa nas bordas.",
      "config": {
        "inputs": [
          {
            "layer": "altura",
            "weight": 0.45
          },
          {
            "layer": "distancia",
            "weight": 0.55
          }
        ],
        "op": "sum",
        "layer": "altura",
        "clamp": true
      }
    },
    {
      "id": "mar",
      "operator": "Fill",
      "description": "Abaixo do nível do mar: mar.",
      "config": {
        "layer": "terreno",
        "tile": "mar"
      },
      "conditions": [
        {
          "type": "scalar_in_range",
          "layer": "altura",
          "max": {
            "$param": "nivel_do_mar"
          }
        }
      ]
    },
    {
      "id": "praia",
      "operator": "Fill",
      "description": "Logo acima do mar: areia.",
      "config": {
        "layer": "terreno",
        "tile": "areia"
      },
      "conditions": [
        {
          "type": "scalar_in_range",
          "layer": "altura",
          "min": {
            "$param": "nivel_do_mar"
          },
          "max": {
            "$expr": "nivel_do_mar + 0.03"
          }
        }
      ]
    },
    {
      "id": "campo",
      "operator": "Fill",
      "description": "Terras baixas: grama.",
      "config": {
        "layer": "terreno",
        "tile": "grama"
      },
      "conditions": [
        {
          "type": "scalar_in_range",
          "layer": "altura",
          "min": {
            "$expr": "nivel_do_mar + 0.03"
          },
          "max": 0.58
        }
      ]
    },
    {
      "id": "mata",
      "operator": "Fill",
      "description": "Encostas: mata.",
      "config": {
        "layer": "terreno",
        "tile": "mata"
      },
      "conditions": [
        {
          "type": "scalar_in_range",
          "layer": "altura",
          "min": 0.58,
          "max": 0.68
        }
      ]
    },
    {
      "id": "pedra",
      "operator": "Fill",
      "description": "Alto: pedra.",
      "config": {
        "layer": "terreno",
        "tile": "pedra"
      },
      "conditions": [
        {
          "type": "scalar_in_range",
          "layer": "altura",
          "min": 0.68,
          "max": 0.78
        }
      ]
    },
    {
      "id": "neve",
      "operator": "Fill",
      "description": "Os picos: neve.",
      "config": {
        "layer": "terreno",
        "tile": "neve"
      },
      "conditions": [
        {
          "type": "scalar_in_range",
          "layer": "altura",
          "min": 0.78
        }
      ]
    }
  ]
}
