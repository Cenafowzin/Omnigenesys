{
  "version": 2,
  "description": "Arquipélago: noise fBm com gradiente fraco e mar alto, pintado por faixas de altura; as ilhotas pequenas viram mar. Os params mudam a escala do relevo, o nível do mar e o tamanho da menor ilha.",
  "seed": 512,
  "size": {
    "width": 64,
    "height": 40
  },
  "layers": [
    "terreno",
    {
      "name": "altura",
      "kind": "scalar"
    },
    {
      "name": "distancia",
      "kind": "scalar"
    },
    {
      "name": "tamanho",
      "kind": "scalar"
    }
  ],
  "tiles": [
    "mar",
    "areia",
    "grama",
    "mata",
    "pedra"
  ],
  "params": {
    "escala": {
      "type": "number",
      "default": 22,
      "min": 6,
      "max": 120,
      "step": 1,
      "description": "Tamanho das formas do relevo, em células: menor, mais ilhas e menores"
    },
    "nivel_do_mar": {
      "type": "number",
      "default": 0.56,
      "min": 0.4,
      "max": 0.62,
      "step": 0.01,
      "description": "Altura abaixo da qual é mar: mais alto, menos terra; a praia é a faixa logo acima"
    },
    "menor_ilha": {
      "type": "integer",
      "default": 6,
      "min": 1,
      "max": 200,
      "description": "Ilhas com menos células que isso afundam"
    }
  },
  "steps": [
    {
      "id": "relevo",
      "operator": "Noise",
      "description": "Ruído fBm (OpenSimplex2, 3 oitavas) de 0 a 1, mais fino que o da ilha: muitas formas pequenas.",
      "config": {
        "layer": "altura",
        "wavelength": {
          "$param": "escala"
        },
        "octaves": 3
      }
    },
    {
      "id": "centro",
      "operator": "RadialGradient",
      "description": "Distância do centro: 0 no meio, 1 numa borda quase quadrada que toca os quatro lados do mapa, em qualquer tamanho (os raios são fração de cada lado).",
      "config": {
        "layer": "distancia",
        "radius_of": "each_side",
        "shape": 0.75
      }
    },
    {
      "id": "encosta",
      "operator": "Curve",
      "description": "Eleva a distância ao quadrado e inverte: 1 no centro, caindo devagar perto do meio e depressa perto da borda.",
      "config": {
        "from": "distancia",
        "layer": "distancia",
        "curve": {
          "kind": "power",
          "exponent": 2
        },
        "invert": true
      }
    },
    {
      "id": "costa",
      "operator": "Combine",
      "description": "Mistura a altura com o gradiente (os pesos somam 1): alta no centro, baixa nas bordas.",
      "config": {
        "inputs": [
          {
            "layer": "altura",
            "weight": 0.75
          },
          {
            "layer": "distancia",
            "weight": 0.25
          }
        ],
        "op": "sum",
        "layer": "altura",
        "clamp": true
      }
    },
    {
      "id": "mar",
      "operator": "Fill",
      "description": "Abaixo do nível do mar: mar.",
      "config": {
        "layer": "terreno",
        "tile": "mar"
      },
      "conditions": [
        {
          "type": "scalar_in_range",
          "layer": "altura",
          "max": {
            "$param": "nivel_do_mar"
          }
        }
      ]
    },
    {
      "id": "praia",
      "operator": "Fill",
      "description": "Logo acima do mar: areia.",
      "config": {
        "layer": "terreno",
        "tile": "areia"
      },
      "conditions": [
        {
          "type": "scalar_in_range",
          "layer": "altura",
          "min": {
            "$param": "nivel_do_mar"
          },
          "max": {
            "$expr": "nivel_do_mar + 0.025"
          }
        }
      ]
    },
    {
      "id": "campo",
      "operator": "Fill",
      "description": "Terras baixas: grama.",
      "config": {
        "layer": "terreno",
        "tile": "grama"
      },
      "conditions": [
        {
          "type": "scalar_in_range",
          "layer": "altura",
          "min": {
            "$expr": "nivel_do_mar + 0.025"
          },
          "max": 0.66
        }
      ]
    },
    {
      "id": "mata",
      "operator": "Fill",
      "description": "Encostas: mata.",
      "config": {
        "layer": "terreno",
        "tile": "mata"
      },
      "conditions": [
        {
          "type": "scalar_in_range",
          "layer": "altura",
          "min": 0.66,
          "max": 0.74
        }
      ]
    },
    {
      "id": "pedra",
      "operator": "Fill",
      "description": "Os picos: pedra.",
      "config": {
        "layer": "terreno",
        "tile": "pedra"
      },
      "conditions": [
        {
          "type": "scalar_in_range",
          "layer": "altura",
          "min": 0.74
        }
      ]
    },
    {
      "id": "ilhas",
      "operator": "RegionSize",
      "description": "Tamanho de cada ilha, contado até `menor_ilha`.",
      "config": {
        "from": "terreno",
        "region": [
          "areia",
          "grama",
          "mata",
          "pedra"
        ],
        "connectivity": "orthogonal",
        "layer": "tamanho",
        "cap": {
          "$param": "menor_ilha"
        }
      }
    },
    {
      "id": "sem_ilhotas",
      "operator": "Fill",
      "description": "As ilhas com menos de `menor_ilha` células viram mar.",
      "config": {
        "layer": "terreno",
        "tile": "mar"
      },
      "conditions": [
        {
          "type": "scalar_in_range",
          "layer": "tamanho",
          "min": 1,
          "max": {
            "$param": "menor_ilha"
          }
        }
      ]
    }
  ]
}
